# --- Обязательно: ключи приложения с https://my.telegram.org ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Какие чаты клонировать: private (личные), bot (боты), group (группы), channel (каналы)
CHAT_TYPES=private,group
# Пересылать и свои исходящие сообщения (true/false)
INCLUDE_OUTGOING=false
# Исключить чаты: id или @username через запятую. 777000 (коды входа) исключён всегда.
EXCLUDE_CHATS=
# Если задано, клонировать только эти чаты
ONLY_CHATS=

# Префикс названия клона и убирать ли клоны в архив
CLONE_PREFIX="📥 "
ARCHIVE_CLONES=true

# Надёжность
CATCHUP_INTERVAL_MIN=30     # плановая проверка пропущенного, 0 — выключить
CATCHUP_LIMIT=500           # сколько пропущенных сообщений догружать на чат за раз
MAX_RETRIES=5               # попыток переслать сообщение, прежде чем сдаться
MAX_DISCONNECT_MIN=5        # сколько ждать переподключения, прежде чем пересоздать клиент
COPY_MEDIA_MAX_MB=200       # лимит медиа при копировании из чатов с запретом пересылки
KEEP_DAYS=30                # сколько хранить историю пересланного в базе
FATAL_EXIT_DELAY_SEC=0      # пауза перед выходом при слетевшей сессии (в Docker 600)

LOG_LEVEL=INFO
DATA_DIR=data
