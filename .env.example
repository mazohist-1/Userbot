# --- Обязательно: ключи приложения с https://my.telegram.org ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Лички: все входящие копируются в один чат-клон с этим названием
# (ищется по названию при запуске, если нет — создаётся)
FORWARD_PRIVATE=true
PRIVATE_CLONE_TITLE="Private Messages"
# Пересылать лички от ботов
FORWARD_BOTS=false
# Пересылать и свои исходящие сообщения (true/false)
INCLUDE_OUTGOING=false
# Исключить чаты: id или @username через запятую. 777000 (коды входа) исключён всегда.
EXCLUDE_CHATS=

# Группы: только добавленные командой .clone add, клон называется "Clone: <название>"
GROUP_CLONE_PREFIX="Clone: "
# true — как раньше, создавать клоны для всех групп автоматически
AUTO_CREATE_CLONES=false
# Убирать клоны групп в архив
ARCHIVE_CLONES=false

# Команды: куда отвечать — saved (в «Избранное») или here (в тот же чат)
CMD_REPLY=saved
GET_LIMIT=100               # максимум N для .get last / .get lastI
SEARCH_LIMIT=20             # сколько результатов показывает .get search

# Надёжность
CATCHUP_INTERVAL_MIN=30     # плановая проверка пропущенного, 0 — выключить
CATCHUP_LIMIT=500           # сколько пропущенных сообщений догружать на чат за раз
MAX_RETRIES=5               # попыток переслать сообщение, прежде чем сдаться
MAX_DISCONNECT_MIN=5        # сколько ждать переподключения, прежде чем пересоздать клиент
COPY_MEDIA_MAX_MB=200       # лимит медиа, которое приходится скачивать и загружать заново
KEEP_DAYS=30                # сколько хранить историю пересланного в базе
FATAL_EXIT_DELAY_SEC=0      # пауза перед выходом при слетевшей сессии (в Docker 600)

LOG_LEVEL=INFO
DATA_DIR=data
